{
	"name": "NVDAIAs Moderno",
	"version": "2.0.0",
	"description": "Design tokens of the NVDAIAs visual theme, modern layout: warm orange app bar, light grey page, white cards with rounded corners, status chips and a rounded orange focus ring. Every text pair meets WCAG 2.2 AA (4.5:1; 3:1 only for large bold text) and every non-text indicator meets 3:1.",
	"color": {
		"brand.orange": "#EC7000",
		"brand.orangeDark": "#A84F00",
		"brand.blue": "#003A70",
		"surface.page": "#F2F2F2",
		"surface.card": "#FFFFFF",
		"surface.header": "#EC7000",
		"text.primary": "#252525",
		"text.secondary": "#595959",
		"text.onHeader": "#FFFFFF",
		"text.accent": "#A84F00",
		"text.link": "#003A70",
		"border.card": "#E3E3E3",
		"border.focus": "#EC7000",
		"status.ok": "#1E6B30",
		"status.okBg": "#E7F4EA",
		"status.busy": "#8A4100",
		"status.busyBg": "#FFF1E5",
		"status.error": "#B3261E",
		"status.errorBg": "#FDECEA",
		"status.idle": "#4B4B4B",
		"status.idleBg": "#E6E6E6"
	},
	"font": {
		"family": ["Itaú Text", "Segoe UI Variable Text", "Segoe UI"],
		"family.display": ["Itaú Display", "Segoe UI Variable Display", "Segoe UI Semibold", "Segoe UI"],
		"size.title": 18,
		"size.subtitle": 11,
		"size.status": 10,
		"size.body": 11,
		"size.label": 10
	},
	"space": {
		"xs": 4,
		"sm": 8,
		"md": 12,
		"lg": 16,
		"xl": 24
	},
	"radius": {
		"card": 12,
		"focus": 8,
		"chip": 12
	},
	"border": {
		"card": 1,
		"accent": 4,
		"focus": 3,
		"gap": 4
	},
	"contrast": {
		"text": [
			["text.primary", "surface.page"],
			["text.primary", "surface.card"],
			["text.secondary", "surface.page"],
			["text.secondary", "surface.card"],
			["text.accent", "surface.card"],
			["text.link", "surface.card"],
			["status.ok", "status.okBg"],
			["status.busy", "status.busyBg"],
			["status.error", "status.errorBg"],
			["status.idle", "status.idleBg"]
		],
		"largeText": [
			["text.onHeader", "surface.header"]
		],
		"nonText": [
			["border.focus", "surface.card"],
			["brand.orange", "surface.card"]
		]
	}
}
