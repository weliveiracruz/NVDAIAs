{
	"name": "NVDAIAs Laranja",
	"version": "1.0.0",
	"description": "Design tokens of the NVDAIAs visual theme: warm orange accent, deep navy header, warm off-white surfaces. Every text pair meets WCAG 2.2 AA (4.5:1) and every non-text indicator meets 3:1.",
	"color": {
		"brand.orange": "#EC7000",
		"brand.orangeStrong": "#B85600",
		"brand.navy": "#002B5C",
		"surface.page": "#F7F4F0",
		"surface.card": "#FFFFFF",
		"surface.header": "#002B5C",
		"text.primary": "#1C1C1C",
		"text.secondary": "#55524E",
		"text.onHeader": "#FFFFFF",
		"text.onHeaderMuted": "#C8D3E3",
		"text.accent": "#A84F00",
		"border.idle": "#8A8580",
		"border.focus": "#B85600",
		"status.ok": "#1E6B30",
		"status.busy": "#A84F00",
		"status.error": "#B3261E",
		"status.idle": "#55524E"
	},
	"font": {
		"family": "Segoe UI",
		"size.title": 16,
		"size.subtitle": 10,
		"size.status": 10,
		"size.body": 11,
		"size.label": 10
	},
	"space": {
		"xs": 4,
		"sm": 8,
		"md": 12,
		"lg": 16,
		"xl": 24
	},
	"border": {
		"stripe": 4,
		"idle": 1,
		"focus": 3,
		"gap": 4
	},
	"contrast": {
		"text": [
			["text.primary", "surface.page"],
			["text.primary", "surface.card"],
			["text.secondary", "surface.page"],
			["text.onHeader", "surface.header"],
			["text.onHeaderMuted", "surface.header"],
			["text.accent", "surface.page"],
			["status.ok", "surface.page"],
			["status.busy", "surface.page"],
			["status.error", "surface.page"],
			["status.idle", "surface.page"]
		],
		"nonText": [
			["border.focus", "surface.page"],
			["border.idle", "surface.page"],
			["brand.orange", "surface.header"]
		]
	}
}
