#. Translators: category of the NVDAIAs commands in the Input gestures dialog.
#. Translators: title of the settings category.
#: addon/globalPlugins/NVDAIAs/__init__.py:23
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:188
msgid "NVDAIAs"
msgstr "NVDAIAs"

#. Translators: item of the NVDA Tools menu.
#: addon/globalPlugins/NVDAIAs/__init__.py:60
msgid "NVDAIAs - &Chat with AI…"
msgstr "NVDAIAs - &Conversar com IA…"

#. Translators: help text of the Tools menu item.
#. Translators: description of the command that opens the chat window.
#: addon/globalPlugins/NVDAIAs/__init__.py:62
#: addon/globalPlugins/NVDAIAs/__init__.py:142
msgid "Opens the NVDAIAs window to chat with ChatGPT, Gemini or Claude"
msgstr ""
"Abre a janela do NVDAIAs para conversar com o ChatGPT, o Gemini ou o Claude"

#. Translators: error when the screenshot fails.
#: addon/globalPlugins/NVDAIAs/__init__.py:109
msgid "Could not capture the screen"
msgstr "Não foi possível capturar a tela"

#. Translators: question sent with a screenshot. {what} describes what was
#. captured.
#: addon/globalPlugins/NVDAIAs/__init__.py:112
#, python-brace-format
msgid ""
"Describe this image for a blind person ({what}). Start with a short "
"overview, then describe the important elements, any visible text and how "
"they are arranged."
msgstr ""
"Descreva esta imagem para uma pessoa cega ({what}). Comece com uma visão "
"geral curta e depois descreva os elementos importantes, todo texto visível e"
" como estão organizados."

#. Translators: announced when a question is already being answered.
#: addon/globalPlugins/NVDAIAs/__init__.py:124
#: addon/globalPlugins/NVDAIAs/chatDialog.py:643
#: addon/globalPlugins/NVDAIAs/chatDialog.py:670
#: addon/globalPlugins/NVDAIAs/chatDialog.py:701
#: addon/globalPlugins/NVDAIAs/chatDialog.py:743
msgid "Please wait for the current answer"
msgstr "Aguarde a resposta atual"

#. Translators: file name given to screenshots sent to the AI.
#: addon/globalPlugins/NVDAIAs/__init__.py:129
msgid "screenshot.png"
msgstr "captura-de-tela.png"

#. Translators: announced after sending the screenshot.
#: addon/globalPlugins/NVDAIAs/__init__.py:134
msgid "Image sent, waiting for the description"
msgstr "Imagem enviada, aguardando a descrição"

#. Translators: description of the command that describes the navigator
#. object.
#: addon/globalPlugins/NVDAIAs/__init__.py:150
msgid ""
"Sends an image of the current navigator object to the AI and reads its "
"description"
msgstr ""
"Envia para a IA uma imagem do objeto de navegação atual e lê a descrição"

#. Translators: announced when the navigator object has no position on screen.
#: addon/globalPlugins/NVDAIAs/__init__.py:158
msgid "This object has no position on the screen"
msgstr "Este objeto não tem posição na tela"

#. Translators: describes the captured area. {name} and {role} come from NVDA.
#: addon/globalPlugins/NVDAIAs/__init__.py:166
#, python-brace-format
msgid "screen element: {name} {role}"
msgstr "elemento da tela: {name} {role}"

#. Translators: description of the command that describes the whole screen.
#: addon/globalPlugins/NVDAIAs/__init__.py:171
msgid ""
"Sends an image of the whole screen (current monitor) to the AI and reads its"
" description"
msgstr ""
"Envia para a IA uma imagem da tela inteira (monitor atual) e lê a descrição"

#. Translators: describes the captured area (whole screen).
#: addon/globalPlugins/NVDAIAs/__init__.py:181
msgid "whole screen"
msgstr "tela inteira"

#. Translators: description of the command that opens the feedback form.
#: addon/globalPlugins/NVDAIAs/__init__.py:185
msgid ""
"Opens the NVDAIAs feedback form in the browser (asks for confirmation first)"
msgstr ""
"Abre no navegador o formulário de feedback do NVDAIAs (pede confirmação "
"antes)"

#. Translators: description of the command that opens the settings.
#: addon/globalPlugins/NVDAIAs/__init__.py:194
msgid "Opens the NVDAIAs settings"
msgstr "Abre as configurações do NVDAIAs"

#. Translators: shown above a message that has files attached. {names} is the
#. list of files.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:39
#, python-brace-format
msgid "Attached files: {names}"
msgstr "Arquivos anexados: {names}"

#. Translators: announced after copying a message.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:53
msgid "Copied to the clipboard"
msgstr "Copiado para a área de transferência"

#. Translators: title of the chat window.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:85
msgid "NVDAIAs - Chat with AI"
msgstr "NVDAIAs - Conversa com IA"

#. Translators: subtitle shown in the coloured header of the chat window.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:91
msgid "Chat with ChatGPT, Gemini and Claude"
msgstr "Converse com o ChatGPT, o Gemini e o Claude"

#. Translators: label of the combo box to choose the AI (ChatGPT, Gemini or
#. Claude).
#: addon/globalPlugins/NVDAIAs/chatDialog.py:102
msgid "&AI:"
msgstr "&IA:"

#. Translators: label of the editable combo box with the AI model.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:109
msgid "&Model:"
msgstr "&Modelo:"

#. Translators: label of the list with the messages of the conversation.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:118
msgid "Con&versation:"
msgstr "Con&versa:"

#. Translators: label of the field where the user types the question.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:146
msgid "&Question (Enter sends, Shift+Enter adds a new line):"
msgstr "&Pergunta (Enter envia, Shift+Enter cria nova linha):"

#. Translators: button that attaches files to the next question.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:150
msgid "Attac&h files…"
msgstr "Ane&xar arquivos…"

#. Translators: button that sends the question.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:153
msgid "&Send"
msgstr "E&nviar"

#. Translators: label of the list of files that will be sent with the next
#. question.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:170
msgid "Attached &files (Delete removes):"
msgstr "Arq&uivos anexados (Delete remove):"

#. Translators: button that cancels the question being sent.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:181
msgid "Cance&l sending"
msgstr "&Cancelar envio"

#. Translators: button that opens the selected message in a reading window.
#. Translators: item of the message actions menu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:184
#: addon/globalPlugins/NVDAIAs/chatDialog.py:584
msgid "&Read message"
msgstr "&Ler mensagem"

#. Translators: button that copies the selected message.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:187
msgid "C&opy message"
msgstr "C&opiar mensagem"

#. Translators: button that opens the menu of actions for the selected
#. message.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:190
msgid "Act&ions for this message…"
msgstr "Açõ&es da mensagem…"

#. Translators: button that clears the conversation.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:196
msgid "&New conversation"
msgstr "Nova conve&rsa"

#. Translators: button that saves the conversation to a text file.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:199
msgid "Sav&e conversation…"
msgstr "&Salvar conversa…"

#. Translators: button that opens the connect account (token) screen.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:202
msgid "Connec&t account…"
msgstr "Conec&tar conta…"

#. Translators: button that opens the NVDAIAs settings.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:205
msgid "Settin&gs…"
msgstr "Confi&gurações…"

#. Translators: button that opens the feedback form (asks for confirmation
#. first).
#: addon/globalPlugins/NVDAIAs/chatDialog.py:208
msgid "Send fee&dback…"
msgstr "Enviar fee&dback…"

#. Translators: button that closes the chat window.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:211
msgid "&Close"
msgstr "&Fechar"

#. Translators: prefix of the user's messages in the conversation list.
#. Translators: label of the user in the saved file.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:265
#: addon/globalPlugins/NVDAIAs/chatDialog.py:936
msgid "You"
msgstr "Você"

#. Translators: shown in a message that has files attached. {names} is the
#. list of files.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:271
#: addon/globalPlugins/NVDAIAs/chatDialog.py:936
#, python-brace-format
msgid "[attached: {names}]"
msgstr "[anexos: {names}]"

#. Translators: date format of the previous conversations (Python strftime).
#: addon/globalPlugins/NVDAIAs/chatDialog.py:300
msgid "%Y-%m-%d %H:%M"
msgstr "%d/%m/%Y %H:%M"

#. Translators: one previous conversation in the tree. {date}, {ais} (e.g.
#. Claude, Gemini), {title} (first question) and {count} (messages).
#: addon/globalPlugins/NVDAIAs/chatDialog.py:302
#, python-brace-format
msgid "{date} · {ais} · {title} ({count} messages)"
msgstr "{date} · {ais} · {title} ({count} mensagens)"

#. Translators: first item of the conversation tree. {count} is the number of
#. saved conversations.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:332
#, python-brace-format
msgid "Previous conversations ({count})"
msgstr "Conversas anteriores ({count})"

#. Translators: branch with the messages of the current conversation. {count}
#. is the number of messages.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:381
#, python-brace-format
msgid "Current conversation ({count} messages)"
msgstr "Conversa atual ({count} mensagens)"

#. Translators: branch of the current conversation when it has no messages
#. yet.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:384
msgid "Current conversation (no messages yet)"
msgstr "Conversa atual (ainda sem mensagens)"

#. Translators: last item of the conversation while waiting. {name} is
#. ChatGPT, Gemini or Claude.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:393
#, python-brace-format
msgid "{name} is answering…"
msgstr "{name} está respondendo…"

#. Translators: status line after an error. {name} is the AI.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:442
#, python-brace-format
msgid "{name} · the last question failed, it is back in the Question field"
msgstr "{name} · a última pergunta falhou e voltou para o campo Pergunta"

#. Translators: status line while waiting. {name} is the AI, {model} the
#. model.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:445
#, python-brace-format
msgid "{name} · {model} · answering…"
msgstr "{name} · {model} · respondendo…"

#. Translators: status line when the AI is connected. {name} is the AI,
#. {model} the model.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:448
#, python-brace-format
msgid "{name} · {model} · connected"
msgstr "{name} · {model} · conectado"

#. Translators: status line when the AI has no token. {name} is the AI.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:451
#, python-brace-format
msgid "{name} · not connected, sending a question opens the connection screen"
msgstr ""
"{name} · não conectado; ao enviar uma pergunta, a tela de conexão abre"

#. Translators: announced when the chosen AI has no token yet.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:473
msgid ""
"This AI is not connected yet. A connection screen will open when you send a "
"question."
msgstr ""
"Esta IA ainda não está conectada. A tela de conexão será aberta quando você "
"enviar uma pergunta."

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:537
msgid "Portuguese (Brazil)"
msgstr "português (Brasil)"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:539
msgid "English"
msgstr "inglês"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:541
msgid "Spanish"
msgstr "espanhol"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:543
msgid "French"
msgstr "francês"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:545
msgid "German"
msgstr "alemão"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:547
msgid "Italian"
msgstr "italiano"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:549
msgid "Japanese"
msgstr "japonês"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:551
msgid "Chinese (simplified)"
msgstr "chinês (simplificado)"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:553
msgid "Korean"
msgstr "coreano"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:555
msgid "Arabic"
msgstr "árabe"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:557
msgid "Russian"
msgstr "russo"

#. Translators: a target language of the "Translate to" submenu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:559
msgid "Hindi"
msgstr "hindi"

#. Translators: item of the message actions menu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:586
msgid "&Copy"
msgstr "&Copiar"

#. Translators: item of the actions menu of a message from a previous
#. conversation.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:590
msgid "&Open this conversation to continue it"
msgstr "&Abrir esta conversa para continuar"

#. Translators: item of the message actions menu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:593
msgid "&Delete"
msgstr "&Excluir"

#. Translators: submenu of the message actions menu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:596
msgid "&Translate to"
msgstr "&Traduzir para"

#. Translators: item of the message actions menu, for messages with images.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:599
msgid "Describe this &image in more detail"
msgstr "Descrever esta &imagem com mais detalhes"

#. Translators: item of the message actions menu, for answers.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:602
msgid "I&mprove this answer"
msgstr "&Melhorar esta resposta"

#. Translators: announced when there is no message selected for the actions
#. menu.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:609
msgid "Select a message in the conversation first"
msgstr "Selecione primeiro uma mensagem na conversa"

#. Translators: confirmation before deleting a message. {message} is the start
#. of the message.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:663
#, python-brace-format
msgid ""
"Delete this message from the conversation?\n"
"{message}"
msgstr ""
"Excluir esta mensagem da conversa?\n"
"{message}"

#. Translators: announced after deleting a message.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:673
msgid "Message deleted"
msgstr "Mensagem excluída"

#. Translators: request sent to the AI to translate a message. {language} is
#. the target language, {text} the message.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:679
#, python-brace-format
msgid ""
"Translate the message below into {language}. Answer only with the translation, keeping the formatting.\n"
"\n"
"{text}"
msgstr ""
"Traduza a mensagem abaixo para {language}. Responda somente com a tradução, mantendo a formatação.\n"
"\n"
"{text}"

#. Translators: announced after asking for a translation. {language} is the
#. target language.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:681
#, python-brace-format
msgid "Translating to {language}"
msgstr "Traduzindo para {language}"

#. Translators: request sent to the AI to describe images in detail. {names}
#. are the image file names.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:686
#, python-brace-format
msgid ""
"Describe in much more detail the image(s) {names} sent earlier in this "
"conversation: every element, all visible text, colours, positions and "
"anything else a blind person would want to know."
msgstr ""
"Descreva com muito mais detalhes a(s) imagem(ns) {names} enviada(s) antes "
"nesta conversa: cada elemento, todo o texto visível, cores, posições e tudo "
"o mais que uma pessoa cega gostaria de saber."

#. Translators: announced after asking for a detailed description.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:690
msgid "Asking for a detailed description of the image"
msgstr "Pedindo uma descrição detalhada da imagem"

#. Translators: request sent to the AI to improve an answer. {text} is the
#. answer.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:694
#, python-brace-format
msgid ""
"Improve the answer below: make it clearer, more complete, correct and well organised, in the same language. Answer only with the improved version.\n"
"\n"
"{text}"
msgstr ""
"Melhore a resposta abaixo: deixe-a mais clara, completa, correta e bem organizada, no mesmo idioma. Responda somente com a versão melhorada.\n"
"\n"
"{text}"

#. Translators: announced after asking for an improved answer.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:696
msgid "Asking for an improved answer"
msgstr "Pedindo uma resposta melhorada"

#. Translators: error when a saved conversation cannot be opened.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:708
msgid "Could not open this conversation"
msgstr "Não foi possível abrir esta conversa"

#. Translators: announced after opening a previous conversation. {title} is
#. its first question, {count} the number of messages.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:713
#, python-brace-format
msgid ""
"Conversation \"{title}\" opened, {count} messages. Continue it in the "
"Question field."
msgstr ""
"Conversa \"{title}\" aberta, {count} mensagens. Continue no campo Pergunta."

#. Translators: confirmation before deleting a previous conversation. {title}
#. is its first question.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:721
#, python-brace-format
msgid "Delete the conversation \"{title}\" from the history?"
msgstr "Apagar a conversa \"{title}\" do histórico?"

#. Translators: announced after deleting a previous conversation.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:729
msgid "Conversation deleted"
msgstr "Conversa apagada"

#. Translators: question sent when the user attaches files without typing
#. anything.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:735
msgid "Please analyse the attached file(s) and summarise the content."
msgstr "Analise o(s) arquivo(s) anexado(s) e resuma o conteúdo."

#. Translators: announced when trying to send an empty question.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:738
msgid "Type a question first"
msgstr "Digite uma pergunta primeiro"

#. Translators: announced after sending with files. {name} is the AI, {count}
#. the number of files.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:764
#, python-brace-format
msgid "Sent to {name} with {count} file(s)"
msgstr "Enviado para o {name} com {count} arquivo(s)"

#. Translators: announced after sending. {name} is ChatGPT, Gemini or Claude.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:767
#, python-brace-format
msgid "Sent to {name}"
msgstr "Enviado para o {name}"

#. Translators: kind of attached file shown in the list.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:775
msgid "image"
msgstr "imagem"

#. Translators: kind of attached file shown in the list.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:777
msgid "PDF"
msgstr "PDF"

#. Translators: kind of attached file shown in the list.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:779
msgid "audio or video"
msgstr "áudio ou vídeo"

#. Translators: kind of attached file shown in the list.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:781
msgid "text"
msgstr "texto"

#. Translators: appended when a long text file was cut.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:786
msgid "[truncated]"
msgstr "[cortado]"

#. Translators: announced after attaching. {names} are the files, {count} the
#. total waiting to be sent.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:812
#, python-brace-format
msgid ""
"Attached: {names}. {count} file(s) will be sent with the next question."
msgstr ""
"Anexado: {names}. {count} arquivo(s) serão enviados com a próxima pergunta."

#. Translators: warning when audio or video is attached and the AI is not
#. Gemini.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:817
msgid ""
"Attention: only Gemini can listen to audio and watch video. Choose Gemini in"
" the AI box."
msgstr ""
"Atenção: só o Gemini consegue ouvir áudio e assistir vídeo. Escolha o Gemini"
" na caixa IA."

#. Translators: warning when a text was cut because it is too long.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:820
msgid "A very long text was cut to fit."
msgstr "Um texto muito longo foi cortado para caber."

#. Translators: error when a file is too big. {name} is the file, {max} the
#. limit.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:828
#, python-brace-format
msgid "The file {name} is too big. The limit is {max}."
msgstr "O arquivo {name} é grande demais. O limite é {max}."

#. Translators: error when a file is empty or has no text.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:831
#, python-brace-format
msgid "The file {name} is empty or has no readable content."
msgstr "O arquivo {name} está vazio ou não tem conteúdo legível."

#. Translators: error for .doc, .xls and .ppt files.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:834
#, python-brace-format
msgid ""
"The file {name} uses an old Office format that cannot be read here. Open it "
"in Office and save it as .docx, .xlsx, .pptx or PDF, then attach it again."
msgstr ""
"O arquivo {name} está num formato antigo do Office que não pode ser lido "
"aqui. Abra no Office, salve como .docx, .xlsx, .pptx ou PDF e anexe de novo."

#. Translators: error for documents that look malicious (zip bomb, XML
#. entities).
#: addon/globalPlugins/NVDAIAs/chatDialog.py:837
#, python-brace-format
msgid ""
"The file {name} was not opened because it looks damaged or unsafe (it "
"expands too much or has unsafe content)."
msgstr ""
"O arquivo {name} não foi aberto porque parece danificado ou inseguro (se "
"expande demais ou tem conteúdo inseguro)."

#. Translators: error for files without readable content (programs,
#. archives...).
#: addon/globalPlugins/NVDAIAs/chatDialog.py:840
#, python-brace-format
msgid ""
"The AIs cannot read the content of {name}. Convert it to PDF, text or an "
"image and attach it again."
msgstr ""
"As IAs não conseguem ler o conteúdo de {name}. Converta para PDF, texto ou "
"imagem e anexe de novo."

#. Translators: error when a file cannot be opened.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:842
#, python-brace-format
msgid "Could not open the file {name}."
msgstr "Não foi possível abrir o arquivo {name}."

#. Translators: title of the dialog to choose files to attach.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:848
msgid "Attach files"
msgstr "Anexar arquivos"

#. Translators: file type filter of the attach dialog.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:850
msgid "All files (*.*)"
msgstr "Todos os arquivos (*.*)"

#. Translators: announced after removing an attached file. {name} is the file.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:867
#, python-brace-format
msgid "{name} removed"
msgstr "{name} removido"

#. Translators: announced after cancelling a question.
#: addon/globalPlugins/NVDAIAs/chatDialog.py:884
msgid "Sending cancelled"
msgstr "Envio cancelado"

#. Translators: title of the window that shows a message written by the user.
