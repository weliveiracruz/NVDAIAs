msgid "Model:"
msgstr "Modelo:"

#. Translators: button that downloads the list of models available for the account. {name} is ChatGPT, Gemini or Claude.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:67
#, python-brace-format
msgid "Update {name} model list"
msgstr "Atualizar lista de modelos do {name}"

#. Translators: button that signs in with the ChatGPT account and uses the ChatGPT plan, without API key.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:76
msgid "Continue with ChatGPT"
msgstr "Continuar com o ChatGPT"

#. Translators: button that signs out of the ChatGPT account (stops using the ChatGPT plan).
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:79
msgid "Sign out of ChatGPT"
msgstr "Sair do ChatGPT"

#. Translators: button that opens the ChatGPT page with the usage of the plan.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:82
msgid "Manage ChatGPT usage"
msgstr "Gerenciar uso do ChatGPT"

#. Translators: checkbox that chooses between the ChatGPT plan and the API token.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:86
msgid "Use my ChatGPT plan instead of the API token when signed in"
msgstr ""
"Usar o meu plano do ChatGPT em vez do token de API quando estiver conectado"

#. Translators: status of the sign in with ChatGPT. {email} is the account.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:133
#, python-brace-format
msgid "ChatGPT plan: signed in as {email}."
msgstr "Plano do ChatGPT: conectado como {email}."

#. Translators: status when not signed in with ChatGPT.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:136
msgid ""
"ChatGPT plan: not signed in. Continue with ChatGPT uses your plan without an "
"API key."
msgstr ""
"Plano do ChatGPT: não conectado. Continuar com o ChatGPT usa o seu plano sem "
"chave de API."

#. Translators: status of a provider with a saved token. {hint} shows the last characters.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:142
#, python-brace-format
msgid "Status: connected, token saved (ends with {hint})."
msgstr "Situação: conectado, token salvo (termina em {hint})."

#. Translators: status of a provider without token.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:145
msgid "Status: not connected, no token saved."
msgstr "Situação: não conectado, nenhum token salvo."

#. Translators: message when testing without token.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:161
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:196
msgid "Paste a token first."
msgstr "Cole um token primeiro."

#. Translators: result of a successful test. {name} is the AI, {count} the number of models.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:177
#, python-brace-format
msgid "Connection to {name} working. {count} models available."
msgstr "A conexão com o {name} está funcionando. {count} modelos disponíveis."

#. Translators: warning when the chosen model is not available. {model} is the model id.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:180
#, python-brace-format
msgid ""
"Attention: the model {model} is not in the list of your account. Choose "
"another one in the Model field."
msgstr ""
"Atenção: o modelo {model} não está na lista da sua conta. Escolha outro no "
"campo Modelo."

#. Translators: reminder that a typed token is only stored after OK/Apply.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:183
msgid "Press OK or Apply to save the new token."
msgstr "Pressione OK ou Aplicar para salvar o novo token."

#. Translators: announced while downloading the model list.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:202
msgid "Updating the model list…"
msgstr "Atualizando a lista de modelos…"

#. Translators: announced after updating the model list. {count} is the number of models.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:215
#, python-brace-format
msgid "{count} models available. Choose one in the Model combo box."
msgstr "{count} modelos disponíveis. Escolha um na caixa Modelo."

#. Translators: confirmation before removing a token. {name} is ChatGPT, Gemini or Claude.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:228
#, python-brace-format
msgid "Remove the saved {name} token from this computer?"
msgstr "Remover deste computador o token salvo do {name}?"

#. Translators: announced after removing a token.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:238
msgid "Token removed"
msgstr "Token removido"

#. Translators: error when the token cannot be saved. {error} is the technical error.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:251
#, python-brace-format
msgid "The token could not be saved: {error}"
msgstr "Não foi possível salvar o token: {error}"

#. Translators: label of the default AI combo box.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:272
msgid "Default &AI:"
msgstr "&IA padrão:"

#. Translators: label of the field with the instructions sent to the AI.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:279
msgid ""
"&Instructions sent to the AI with every question (leave empty for the "
"default):"
msgstr ""
"Ins&truções enviadas à IA em todas as perguntas (deixe vazio para usar o "
"padrão):"

#. Translators: button that restores the default instructions.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:286
msgid "Res&tore default instructions"
msgstr "&Restaurar instruções padrão"

#. Translators: checkbox to read answers automatically.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:290
msgid "&Read answers automatically when they arrive"
msgstr "&Ler as respostas automaticamente quando chegarem"

#. Translators: checkbox to beep while waiting.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:293
msgid "&Beep while waiting for the answer"
msgstr "&Bipar enquanto aguarda a resposta"

#. Translators: checkbox to remove Markdown symbols when reading.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:296
msgid "Remove &formatting symbols (#, *, |) when reading answers"
msgstr "Remover símbolos de &formatação (#, *, |) ao ler as respostas"

#. Translators: checkbox that turns the visual theme on or off.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:300
msgid ""
"Use the &visual theme in NVDAIAs windows (colours, header and focus frame)"
msgstr ""
"Usar o tema &visual nas janelas do NVDAIAs (cores, cabeçalho e moldura de "
"foco)"

#. Translators: checkbox that makes the text of the NVDAIAs windows bigger.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:303
msgid "&Larger text in NVDAIAs windows"
msgstr "Te&xto maior nas janelas do NVDAIAs"

#. Translators: checkbox to keep previous conversations.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:307
msgid "Keep &previous conversations (saved encrypted on this computer)"
msgstr ""
"Guardar as &conversas anteriores (salvas com criptografia neste computador)"

#. Translators: label of the maximum number of saved conversations.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:311
msgid "Maximum number of previous conversations:"
msgstr "Número máximo de conversas anteriores:"

#. Translators: button that deletes all previous conversations.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:318
msgid "&Delete all previous conversations…"
msgstr "&Apagar todas as conversas anteriores…"

#. Translators: label of the maximum answer size (used by Claude).
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:323
msgid "Maximum answer size in tokens (Claude):"
msgstr "Tamanho máximo da resposta em tokens (Claude):"

#. Translators: label of the time limit in seconds.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:331
msgid "Time limit to wait for an answer (seconds):"
msgstr "Tempo limite para aguardar a resposta (segundos):"

#. Translators: confirmation before deleting all previous conversations.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:341
msgid ""
"Delete all previous conversations from this computer? This cannot be undone."
msgstr ""
"Apagar todas as conversas anteriores deste computador? Isso não pode ser "
"desfeito."

#. Translators: announced after deleting all previous conversations.
#: addon/globalPlugins/NVDAIAs/settingsPanel.py:349
msgid "All previous conversations were deleted"
msgstr "Todas as conversas anteriores foram apagadas"
